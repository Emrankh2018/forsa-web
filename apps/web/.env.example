# Names only. Copy to .env.production.local on the server (or set in the systemd unit) and fill in.
# All of these are read when the site is BUILT, so rebuild after changing them.

# Public address of the site, no trailing slash. Used for share images, canonical links and the sitemap.
SITE_URL=

# Leave empty until the go-live gate. "production" lets search engines index the public pages.
FORSA_ENV=

# Optional. Shown on /contact only when set.
NEXT_PUBLIC_CONTACT_EMAIL=

# Read by the running server (not the build): port and address the Node process listens on.
# Nginx forwards to it; keep it on 127.0.0.1 so only Nginx can reach it.
PORT=3000
HOSTNAME=127.0.0.1
