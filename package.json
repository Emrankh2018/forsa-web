{
  "name": "forsa-web",
  "private": true,
  "description": "Forsa platform v4: Next.js web app, shared package, Supabase migrations and tests (npm workspaces).",
  "workspaces": [
    "packages/shared",
    "apps/web",
    "supabase"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w @forsa/web",
    "build": "npm run build -w @forsa/web",
    "start": "npm run start -w @forsa/web",
    "lint": "eslint . && npm run lint -w @forsa/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "copy": "node scripts/check-copy.mjs --self-test && node scripts/check-copy.mjs",
    "e2e": "playwright test",
    "check": "npm run copy && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.16",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
